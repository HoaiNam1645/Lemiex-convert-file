# Server settings
HOST=0.0.0.0
PORT=8009

# Backblaze B2 Configuration
B2_ACCESS_KEY_ID=your_b2_access_key_id
B2_SECRET_ACCESS_KEY=your_b2_secret_access_key
B2_DEFAULT_REGION=us-east-005
B2_BUCKET=Lemiex-Fulfillment
B2_ENDPOINT=https://s3.us-east-005.backblazeb2.com
B2_URL_CLOUD=https://zipimgs.com/file/Lemiex-Fulfillment

# Output paths on B2
B2_JSON_OUTPUT_PATH=converted_json
B2_DST_OUTPUT_PATH=converted_dst
B2_LABEL_OUTPUT_PATH=converted_label
B2_INFO_IMAGE_PATH=info_images
B2_QR_OUTPUT_PATH=convert_qr
B2_MERGED_IMAGE_PATH=merged_image

# Callback API
BE_API_URL=http://localhost:8000

# Dropbox Configuration for Progress Scanner
DROPBOX_ACCESS_KEY=your_dropbox_access_key
DROPBOX_PATH=/.Embroidery_Lemiex
EMBROIDERY_REFRESH=180
EMBROIDERY_LOG_LEVEL=INFO

# Lemiex / Dropbox API endpoints
LEMIEX_API_ENDPOINT=https://manage.lemiex.us/api/orders/process-order
DROPBOX_API_BASE=https://api.dropboxapi.com/2
DROPBOX_TOKEN_BASE=https://manage.lemiex.us/api/telegram
